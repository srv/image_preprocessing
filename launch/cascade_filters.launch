<launch>
    <arg name = "robot_name"        default = "sparus2"/>

    <arg name="bagfile" default="/home/bomiquel/datasets/bagfiles/el_sec/sparus2_stereo_camera_2025-11-10-11-04-46_3.bag" />
    <param name="/use_sim_time" value="true"/>

    <!-- Camera parameters -->
    <arg name="camera" default="flir_spinnaker_stereo_camera"/>
    <arg name = "resolution"         default = "full"/>
    <arg name = "slave_camera_name"  default = "starboard"/>
    <arg name = "master_camera_name" default = "port"/>

    <!-- Image parameters -->
    <arg name = "enable_decimate_x1" default = "false"/>
    <arg name = "enable_decimate_x2" default = "true"/>
    <arg name = "enable_decimate_x4" default = "false"/>
    <arg name = "enable_decimate_x8" default = "false"/>


    <node pkg="rosbag" type="play" name="rosbag" args="--clock $(arg bagfile) -r 0.2" />

    <group ns = "$(arg robot_name)">

        <include file="$(find image_preprocessing)/launch/stereo_processing/stereo_pipeline.launch">
            <arg name="stereo" value="$(arg camera)" />
            <arg name = "resolution"         value = "$(arg resolution)"/>
            <arg name = "slave_camera_name"  value = "$(arg slave_camera_name)"/>
            <arg name = "master_camera_name" value = "$(arg master_camera_name)"/>
            <arg name = "enable_decimate_x1" value = "$(arg enable_decimate_x1)"/>
            <arg name = "enable_decimate_x2" value = "$(arg enable_decimate_x2)"/>
            <arg name = "enable_decimate_x4" value = "$(arg enable_decimate_x4)"/>
            <arg name = "enable_decimate_x8" value = "$(arg enable_decimate_x8)"/>
        </include>

        <node pkg="image_preprocessing" type="mono_dehazer_node" name="mono_dehazer_node" respawn="true" output="screen">
            <remap from="image" to="/sparus2/flir_spinnaker_stereo_camera/scaled_x2/port/image_raw"/>
            <remap from="/dehazed/image_rect_color" to="/sparus2/flir_spinnaker_stereo_camera/scaled_x2/port/dehazed_image_raw"/>
        </node>

        <node pkg="image_preprocessing" type="mono_clahe_node" name="mono_clahe_node" respawn="true" output="screen">
            <remap from="img_in" to="/sparus2/flir_spinnaker_stereo_camera/scaled_x2/port/dehazed_image_raw"/>
            <remap from="img_out" to="/sparus2/flir_spinnaker_stereo_camera/scaled_x2/port/dehazed_clahe_image_raw"/>
            <param name="clip_limit" value="3"/>
        </node>

    </group>
</launch>